# OpenAI-compatible Chat Completions endpoint. Keep the real .env untracked.
AUDIT_API_KEY=
AUDIT_BASE_URL=https://api.openai.com/v1
AUDIT_MODEL=
AUDIT_TIMEOUT_SECONDS=60

# TypeSafe Jev System One API. Jev is not Chat Completions compatible.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=30
